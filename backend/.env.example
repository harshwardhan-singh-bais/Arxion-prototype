# ── Arxion Backend — Environment Configuration ─────────────────────────────
# Copy this file to .env and fill in your values.

# ── Google Gemini ───────────────────────────────────────────────────────────
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Qdrant Cloud ─────────────────────────────────────────────────────────────
# Sign up at https://cloud.qdrant.io and create a free cluster.
# Your cluster URL looks like: https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# ── Local Qdrant (alternative to Cloud, via Docker) ──────────────────────────
# To run locally instead, comment out the Cloud lines above and use:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# Start Qdrant with: docker run -p 6333:6333 qdrant/qdrant

# ── Application ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
DEBUG=True

# ── CORS (adjust origin if your frontend port changes) ───────────────────────
# CORS_ORIGINS=["http://localhost:3000"]
